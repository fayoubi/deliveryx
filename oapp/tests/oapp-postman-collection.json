							"listen": "prerequest",
							"script": {
								"exec": [
									"// Reset menu to draft status",
									"const resetMenuRequest = {",
									"    url: pm.environment.get('base_url') + '/internal/menus/' + pm.environment.get('menu_id') + '/status',",
									"    method: 'PUT',",
									"    header: {",
									"        'Content-Type': 'application/json'",
									"    },",
									"    body: {",
									"        mode: 'raw',",
									"        raw: JSON.stringify({",
									"            status: 'draft'",
									"        })",
									"    }",
									"};",
									"",
									"pm.sendRequest(resetMenuRequest, function (err, response) {",
									"    if (err) {",
									"        console.log('Error resetting menu to draft:', err);",
									"    } else {",
									"        console.log('Menu reset to draft status');",
									"        ",
									"        // Submit menu for review",
									"        const submitRequest = {",
									"            url: pm.environment.get('base_url') + '/menus/' + pm.environment.get('menu_id') + '/submit',",
									"            method: 'POST'",
									"        };",
									"        ",
									"        pm.sendRequest(submitRequest, function (err, response) {",
									"            if (err) {",
									"                console.log('Error submitting menu:', err);",
									"            } else {",
									"                console.log('Menu submitted for review');",
