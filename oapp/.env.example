# DeliveryX Environment Variables - Local Development

# PostgreSQL Configuration
POSTGRES_USER=deliveryx
POSTGRES_PASSWORD=deliveryx_dev_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Names
DB_RESTAURANT=deliveryx_restaurant
DB_MENU=deliveryx_menu
DB_APPROVAL=deliveryx_approval

# RabbitMQ Configuration
RABBITMQ_USER=deliveryx
RABBITMQ_PASSWORD=deliveryx_dev_pass
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API Gateway Configuration
API_GATEWAY_HOST=localhost
API_GATEWAY_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Service Ports (for future use)
RESTAURANT_SERVICE_PORT=8081
MENU_SERVICE_PORT=8082
APPROVAL_SERVICE_PORT=8083
MEDIA_SERVICE_PORT=8084

# AWS Configuration (for future cloud migration)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=deliveryx-media

# Environment
ENVIRONMENT=local
LOG_LEVEL=debug
